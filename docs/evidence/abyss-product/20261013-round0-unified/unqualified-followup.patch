     float circle=radius-length(vec2(q,point.y-radius));
     float clip=max(-q,max(-point.y,point.y-radius));
     return max(circle,clip);
@@ -155,7 +158,7 @@ float physicalContact(vec2 p,vec4 rect,float radius) {
 }
