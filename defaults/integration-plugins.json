{
  "integrations": [
    "tlp",
    "thinkfan",
    "nexus",
    "spaced_repetition",
    "exercises_tracker"
  ],
  "dependencies": {
    "nexus": {
      "userSpace": true,
      "requiresSystemHelpers": false,
      "packages": [
        "python3"
      ],
      "binaries": [
        "python3"
      ],
      "helpers": [],
      "setupCommand": "",
      "note": "User-space plugin (requires Python 3; no root helpers needed)."
    },
    "spaced_repetition": {
      "userSpace": true,
      "requiresSystemHelpers": false,
      "packages": [],
      "binaries": [],
      "helpers": [],
      "setupCommand": "",
      "note": "User-space plugin (no system dependencies or root helpers needed)."
    },
    "exercises_tracker": {
      "userSpace": true,
      "requiresSystemHelpers": false,
      "packages": [
        "python3"
      ],
      "binaries": [
        "python3"
      ],
      "helpers": [],
      "setupCommand": "",
      "note": "User-space plugin (requires Python 3 for safe photo import; no root helpers needed)."
    },
    "tlp": {
      "userSpace": false,
      "requiresSystemHelpers": true,
      "packages": [
        "tlp",
        "alis-deps"
      ],
      "binaries": [
        "tlp"
      ],
      "helpers": [
        "/usr/libexec/alis-battery-charge-limit",
        "/usr/libexec/alis-intergration-system-provision"
      ],
      "setupCommand": "./setup install-deps",
      "note": "Requires tlp (via ./setup install-deps / alis-deps) and TLP battery helpers (./setup integrations)."
    },
    "thinkfan": {
      "userSpace": false,
      "requiresSystemHelpers": true,
      "packages": [
        "thinkfan",
        "alis-deps"
      ],
      "binaries": [
        "thinkfan"
      ],
      "helpers": [
        "/usr/libexec/alis-thinkfan",
        "/usr/libexec/alis-intergration-system-provision"
      ],
      "setupCommand": "./setup install-deps",
      "note": "Requires thinkfan (via ./setup install-deps / alis-deps) and Thinkfan helpers (./setup integrations)."
    }
  },
  "settings": {
    "tlp": "modules/settings/TlpPowerSettings.qml",
    "nexus": "modules/settings/NexusThemeSettings.qml",
    "nexusTodo": "modules/settings/NexusTodoSettings.qml",
    "tlpRow": "modules/settings/TlpSettingRow.qml",
    "tlpWaffle": "modules/waffle/settings/WTlpPowerSettings.qml",
    "tlpWaffleRow": "modules/waffle/settings/WTlpSettingRow.qml",
    "thinkfan": "modules/settings/ThinkfanSettings.qml",
    "spacedRepetition": "modules/settings/DashboardSpacedRepetitionSettings.qml",
    "exercisesTracker": "modules/settings/DashboardExercisesTrackerSettings.qml"
  },
  "plugins": [
    {
      "id": "tlp",
      "name": "TLP",
      "icon": "battery_saver",
      "capabilities": [
        {
          "id": "power",
          "name": "Power",
          "settings": "tlp",
          "waffleSettings": "tlpWaffle"
        }
      ]
    },
    {
      "id": "thinkfan",
      "name": "Thinkfan",
      "icon": "mode_fan",
      "capabilities": [
        {
          "id": "cooling",
          "name": "Cooling",
          "settings": "thinkfan"
        }
      ]
    },
    {
      "id": "nexus",
      "name": "Nexus",
      "icon": "hub",
      "capabilities": [
        {
          "id": "theming",
          "name": "Theming",
          "settings": "nexus"
        },
        {
          "id": "quicknotes",
          "name": "Quicknotes",
          "settings": "nexusTodo",
          "view": "quicknotes"
        },
        {
          "id": "todo",
          "name": "Todo",
          "settings": "nexusTodo",
          "view": "todo"
        }
      ]
    },
    {
      "id": "spaced_repetition",
      "name": "Spaced Repetition",
      "icon": "school",
      "capabilities": [
        {
          "id": "vocabulary",
          "name": "Vocabulary & Cards",
          "settings": "spacedRepetition"
        }
      ]
    },
    {
      "id": "exercises_tracker",
      "name": "Exercises Tracker",
      "icon": "fitness_center",
      "capabilities": [
        {
          "id": "workouts",
          "name": "Workouts & Body Tracker",
          "settings": "exercisesTracker"
        }
      ]
    }
  ]
}
