{
  "integrations": [
    "tlp",
    "thinkfan",
    "obsidian",
    "spaced_repetition"
  ],
  "settings": {
    "tlp": "modules/settings/TlpPowerSettings.qml",
    "obsidian": "modules/settings/ObsidianThemeSettings.qml",
    "obsidianTodo": "modules/settings/ObsidianTodoSettings.qml",
    "tlpRow": "modules/settings/TlpSettingRow.qml",
    "tlpWaffle": "modules/waffle/settings/WTlpPowerSettings.qml",
    "tlpWaffleRow": "modules/waffle/settings/WTlpSettingRow.qml",
    "thinkfan": "modules/settings/ThinkfanSettings.qml",
    "spacedRepetition": "modules/settings/DashboardSpacedRepetitionSettings.qml"
  },
  "plugins": [
    {
      "id": "tlp",
      "name": "TLP",
      "icon": "battery_saver",
      "capabilities": [
        {
          "id": "power",
          "name": "Power",
          "settings": "tlp",
          "waffleSettings": "tlpWaffle"
        }
      ]
    },
    {
      "id": "thinkfan",
      "name": "Thinkfan",
      "icon": "mode_fan",
      "capabilities": [
        {
          "id": "cooling",
          "name": "Cooling",
          "settings": "thinkfan"
        }
      ]
    },
    {
      "id": "obsidian",
      "name": "Obsidian",
      "icon": "diamond",
      "capabilities": [
        {
          "id": "theming",
          "name": "Theming",
          "settings": "obsidian"
        },
        {
          "id": "quicknotes",
          "name": "Quicknotes",
          "settings": "obsidianTodo",
          "view": "quicknotes"
        },
        {
          "id": "todo",
          "name": "Todo",
          "settings": "obsidianTodo",
          "view": "todo"
        }
      ]
    },
    {
      "id": "spaced_repetition",
      "name": "Spaced Repetition",
      "icon": "school",
      "capabilities": [
        {
          "id": "vocabulary",
          "name": "Vocabulary & Cards",
          "settings": "spacedRepetition"
        }
      ]
    }
  ]
}
