{
  "integrations": [
    "tlp",
    "thinkfan",
    "nexus",
    "spaced_repetition",
    "exercises_tracker",
    "alis_files"
  ],
  "builtinPlugins": [
    "alis_files",
    "nexus",
    "spaced_repetition",
    "exercises_tracker"
  ],
  "dependencies": {
    "alis_files": {
      "userSpace": true,
      "builtIn": true,
      "requiresSystemHelpers": false,
      "packages": [
        "gtk4",
        "rust"
      ],
      "binaries": [
        "python3"
      ],
      "helpers": [],
      "setupCommand": "",
      "helpersCommand": "",
      "note": "Built-in user-space GTK4 file manager (compiled locally on install/update; no root helpers needed)."
    },
    "nexus": {
      "userSpace": true,
      "builtIn": true,
      "requiresSystemHelpers": false,
      "packages": [
        "python3"
      ],
      "binaries": [
        "python3"
      ],
      "helpers": [],
      "setupCommand": "",
      "helpersCommand": "",
      "note": "User-space plugin (requires Python 3; no root helpers needed)."
    },
    "spaced_repetition": {
      "userSpace": true,
      "builtIn": true,
      "requiresSystemHelpers": false,
      "packages": [
        "python3"
      ],
      "binaries": [
        "python3"
      ],
      "helpers": [],
      "setupCommand": "",
      "helpersCommand": "",
      "note": "User-space plugin (requires Python 3 for word lookup; no root helpers needed)."
    },
    "exercises_tracker": {
      "userSpace": true,
      "builtIn": true,
      "requiresSystemHelpers": false,
      "packages": [
        "python3"
      ],
      "binaries": [
        "python3"
      ],
      "helpers": [],
      "setupCommand": "",
      "helpersCommand": "",
      "note": "User-space plugin (requires Python 3 for safe photo import; no root helpers needed)."
    },
    "tlp": {
      "userSpace": false,
      "requiresSystemHelpers": true,
      "helpersScope": "tlp",
      "packages": [
        "tlp",
        "alis-deps"
      ],
      "binaries": [
        "tlp"
      ],
      "helpers": [
        "/usr/libexec/alis-battery-charge-limit",
        "/usr/libexec/alis-intergration-system-provision"
      ],
      "setupCommand": "./setup install-deps",
      "helpersCommand": "./setup integrations install tlp",
      "removeHelpersCommand": "./setup integrations remove tlp",
      "note": "Requires tlp (via ./setup install-deps / alis-deps) and TLP battery helpers (./setup integrations install tlp)."
    },
    "thinkfan": {
      "userSpace": false,
      "requiresSystemHelpers": true,
      "helpersScope": "thinkfan",
      "packages": [
        "thinkfan",
        "alis-deps"
      ],
      "binaries": [
        "thinkfan"
      ],
      "helpers": [
        "/usr/libexec/alis-thinkfan",
        "/usr/libexec/alis-intergration-system-provision"
      ],
      "setupCommand": "./setup install-deps",
      "helpersCommand": "./setup integrations install thinkfan",
      "removeHelpersCommand": "./setup integrations remove thinkfan",
      "note": "Requires thinkfan (via ./setup install-deps / alis-deps) and Thinkfan helpers (./setup integrations install thinkfan)."
    }
  },
  "settings": {
    "tlp": "plugins/tlp/modules/settings/TlpPowerSettings.qml",
    "nexus": "plugins/nexus/modules/settings/NexusThemeSettings.qml",
    "nexusTodo": "plugins/nexus/modules/settings/NexusTodoSettings.qml",
    "tlpRow": "plugins/tlp/modules/settings/TlpSettingRow.qml",
    "tlpWaffle": "plugins/tlp/modules/waffle/settings/WTlpPowerSettings.qml",
    "tlpWaffleRow": "plugins/tlp/modules/waffle/settings/WTlpSettingRow.qml",
    "thinkfan": "plugins/thinkfan/modules/settings/ThinkfanSettings.qml",
    "spacedRepetition": "plugins/spaced_repetition/modules/settings/DashboardSpacedRepetitionSettings.qml",
    "exercisesTracker": "plugins/exercises_tracker/modules/settings/DashboardExercisesTrackerSettings.qml",
    "alisFiles": "plugins/alis_files/modules/settings/AlisFilesSettings.qml"
  },
  "views": {
    "nexusWorkspace": "plugins/nexus/modules/nexus/NexusWorkspace.qml",
    "spacedRepetitionDashboard": "plugins/spaced_repetition/modules/dashboard/DashboardSpacedRepetition.qml",
    "exercisesTrackerDashboard": "plugins/exercises_tracker/modules/dashboard/DashboardExercisesTracker.qml"
  },
  "backends": {
    "managedTodo": "plugins/nexus/services/NexusTodoBackend.qml",
    "dailyTodo": "plugins/nexus/services/DailyNoteTodoBackend.qml"
  },
  "scripts": {
    "spacedRepetitionLookup": "plugins/spaced_repetition/scripts/integrations/lookup_word_level.py",
    "exercisesTrackerHelper": "plugins/exercises_tracker/scripts/integrations/exercises_tracker.py",
    "alisFilesInstaller": "plugins/alis_files/scripts/install_alis_files.py"
  },
  "plugins": [
    {
      "id": "tlp",
      "name": "TLP",
      "icon": "battery_saver",
      "helpersScope": "tlp",
      "capabilities": [
        {
          "id": "power",
          "name": "Power",
          "settings": "tlp",
          "waffleSettings": "tlpWaffle"
        }
      ]
    },
    {
      "id": "thinkfan",
      "name": "Thinkfan",
      "icon": "mode_fan",
      "helpersScope": "thinkfan",
      "capabilities": [
        {
          "id": "cooling",
          "name": "Cooling",
          "settings": "thinkfan"
        }
      ]
    },
    {
      "id": "nexus",
      "name": "Nexus",
      "icon": "hub",
      "capabilities": [
        {
          "id": "workspace",
          "name": "Nexus & Vault",
          "settings": "nexus"
        }
      ]
    },
    {
      "id": "spaced_repetition",
      "name": "Spaced Repetition",
      "icon": "school",
      "capabilities": [
        {
          "id": "vocabulary",
          "name": "Vocabulary & Cards",
          "settings": "spacedRepetition"
        }
      ]
    },
    {
      "id": "exercises_tracker",
      "name": "Exercises Tracker",
      "icon": "fitness_center",
      "capabilities": [
        {
          "id": "workouts",
          "name": "Workouts & Body Tracker",
          "settings": "exercisesTracker"
        }
      ]
    },
    {
      "id": "alis_files",
      "name": "Alis Files",
      "icon": "folder_open",
      "capabilities": [
        {
          "id": "files",
          "name": "File Manager",
          "settings": "alisFiles"
        }
      ]
    }
  ]
}
