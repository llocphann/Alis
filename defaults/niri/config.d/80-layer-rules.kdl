// ─────────────────────────────────────────────────────────────────────────────
// 80 — Layer rules
// ─────────────────────────────────────────────────────────────────────────────
// Docs: https://niri-wm.github.io/niri/Configuration:-Layer-Rules
//
// Layer-shell surfaces are used by bars, panels, wallpaper renderers, and
// overlays. Alis uses them for its overview/backdrop wallpaper surfaces.
//
// place-within-backdrop = true tells Niri to render the surface inside the
// compositor overview backdrop. Background/Bottom layers otherwise zoom with
// the workspace, leaving the area exposed by a hot-corner overview as a solid
// compositor color.
// ─────────────────────────────────────────────────────────────────────────────

// Shared Material/Abyss backdrop wallpaper. Abyss intentionally reuses the
// historical namespace so upgraded installs keep the stable Niri layer rule.
layer-rule {
    match namespace="quickshell:iiBackdrop"
    place-within-backdrop true
    opacity 1.0
}

// Waffle keeps its own backdrop renderer and namespace.
layer-rule {
    match namespace="quickshell:wBackdrop"
    place-within-backdrop true
    opacity 1.0
}

// ── Examples ────────────────────────────────────────────────────────────────
// Make a specific layer surface semi-transparent:
// layer-rule {
//     match namespace="waybar"
//     opacity 0.9
// }
//
// Block a layer surface from screen capture:
// layer-rule {
//     match namespace="some-private-overlay"
//     block-out-from "screencast"
// }
