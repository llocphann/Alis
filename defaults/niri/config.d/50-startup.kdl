// ─────────────────────────────────────────────────────────────────────────────
// 50 — Processes spawned at login
// ─────────────────────────────────────────────────────────────────────────────
// Each line runs once when Niri starts. For daemons that support it,
// xdg-desktop-autostart (systemd) is an alternative.
//
// Tip: use spawn-sh-at-startup for shell pipelines or variable expansion.
// ─────────────────────────────────────────────────────────────────────────────

// Export XDG_MENU_PREFIX into the systemd user session and rebuild the
// sycoca database so KDE/Qt apps see the correct .desktop entries.
spawn-at-startup "bash" "-c" "systemctl --user import-environment XDG_MENU_PREFIX QT_IM_MODULE XMODIFIERS && kbuildsycoca6"

// Clipboard history: Alis's native Wayland data-control watcher captures both
// text (stripping browser HTML markup) and images directly without requiring
// external wl-clipboard or cliphist. Niri owns the long-running watcher directly.
// Access via Alis's clipboard overlay (Mod+V).
spawn-at-startup "bash" "-c" "exec ~/.config/quickshell/alis/scripts/native-dispatch clipboard watch"

// Polkit authentication agent — Alis ships a built-in Quickshell Polkit agent
// (enabled by default). Uncomment an external agent below only if you disable
// Alis's built-in polkit module or prefer a standalone desktop agent.
// spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// ── Alis shell ──────────────────────────────────────────────────────────────
// Alis is managed by the user systemd service (alis.service).
// Do not add a compositor startup entry here or you'll get two shells.
