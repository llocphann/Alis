pkgname=alis-audio
pkgver=1.0
pkgrel=4
pkgdesc='Alis - audio dependency bundle'
arch=(any)
license=('GPL-3.0-only')
depends=(
  # PipeWire audio stack
  pipewire
  pipewire-pulse
  pipewire-alsa
  wireplumber

  # Media control
  libdbusmenu-gtk3
  pavucontrol

  # Audio visualizer
  cava

  # Media playback
  mpv
  mpd
  mpd-mpris
)

optdepends=(
  'easyeffects: optional audio effects and equalizer backend'
  'socat: optional EasyEffects control transport for equalizer'
  'playerctl: optional MPRIS CLI utility'
)
