pkgname=alis-core
pkgver=1.0
pkgrel=3
pkgdesc='Alis - core dependency bundle'
arch=(any)
license=('GPL-3.0-only')
depends=(
  # Niri compositor
  niri

  # Basic utilities
  coreutils
  curl
  wget
  ripgrep
  python
  cargo
  xdg-user-dirs
  xdg-utils
  rsync
  git

  # XDG Portals for Niri
  xdg-desktop-portal
  xdg-desktop-portal-gtk
  xdg-desktop-portal-gnome

  # Polkit (Alis ships a built-in Quickshell Polkit authentication agent)
  polkit

  # Network
  networkmanager
  nm-connection-editor
  gnome-keyring

  # File manager runtime (Alis Files built locally via GTK4-rs)
  gtk4

  # Terminal - kitty is default, configurable in Settings
  kitty

  # X11 compatibility
  xwayland-satellite
)
optdepends=(
  'polkit-gnome: optional standalone polkit agent (Alis ships a built-in Quickshell Polkit agent)'
  'awww: optional external animated wallpaper daemon (Alis ships built-in GPU transitions)'
)
