# Meta-package: registers Alis dependencies with pacman
# Purpose: prevents "clean orphans" from removing Alis's deps
# This package contains no files — it only declares dependencies.
#
# Built and installed automatically by ./setup install.
# Safe to remove with: sudo pacman -R alis-deps

pkgname=alis-deps
pkgver=1.0.2
pkgrel=1
pkgdesc='Alis desktop shell - dependency tracker (meta-package)'
url='https://github.com/llocphann/Alis'
arch=(any)
license=('GPL-3.0-only')
conflicts=('inir-deps')
replaces=('inir-deps')

# Dependency candidates tracked when already installed. setup stages this recipe
# and filters depends to packages present in pacman's database before building,
# so optional/AUR packages do not become hard install requirements.
depends=(
  #--- Quickshell + Qt6 runtime ---
  quickshell
  qt6-base
  qt6-declarative
  qt6-svg
  qt6-wayland
  qt6-5compat
  qt6-imageformats
  qt6-multimedia
  qt6-multimedia-ffmpeg
  qt6-positioning
  qt6-quicktimeline
  qt6-sensors
  qt6-tools
  qt6-translations
  qt6-virtualkeyboard

  #--- System libs for Quickshell ---
  jemalloc
  libpipewire
  libxcb
  wayland
  libdrm
  mesa

  #--- KDE/Qt integration ---
  kirigami
  kdialog
  syntax-highlighting
  qt6ct
  kvantum
  plasma-integration
  plasma-browser-integration
  frameworkintegration
  kdecoration
  breeze-icons
  hicolor-icon-theme
  adwaita-icon-theme

  #--- Compositor ---
  niri

  #--- Core utilities ---
  coreutils
  cliphist
  curl
  wget
  ripgrep
  python
  rsync
  git
  fish
  gum
  wl-clipboard
  pacman-contrib
  xdg-user-dirs
  xdg-utils
  fontconfig

  #--- Wayland tools ---
  wlsunset
  swayidle
  swaylock
  grim
  slurp
  swappy
  wf-recorder
  xwayland-satellite

  #--- XDG Portals ---
  xdg-desktop-portal
  xdg-desktop-portal-gtk
  xdg-desktop-portal-gnome

  #--- Audio stack ---
  pipewire
  pipewire-pulse
  pipewire-alsa
  wireplumber
  libdbusmenu-gtk3
  pavucontrol
  mpv
  mpd
  mpd-mpris

  #--- Theming ---
  noto-fonts-emoji
  ttf-dejavu
  ttf-liberation
  ttf-roboto
  ttf-roboto-mono
  papirus-icon-theme

  #--- Desktop integration ---
  polkit
  polkit-gnome
  networkmanager
  nm-connection-editor
  gnome-keyring
  nautilus
  kitty
  fuzzel
  glib2
  starship
  eza
  mission-center

  #--- Power management ---
  ethtool


  #--- Input / HW ---
  upower
  wtype
  ydotool
  ddcutil
  geoclue
  fprintd
  blueman
  kconfig

  #--- Media / image processing ---
  imagemagick
  ffmpeg
  tesseract
  tesseract-data-eng

  #--- Login manager ---
  sddm
)

# AUR / optional packages — listed here so pacman knows about them
# but won't block install if missing.
optdepends=(
  'tlp: power management for the optional Alis-Intergration TLP integration'
  'tlp-pd: power profile provider for the optional Alis-Intergration TLP integration'
  'tlp-rdw: radio device policy for the optional Alis-Intergration TLP integration'
  'cava: audio visualizer for bar'
  'easyeffects: optional audio effects and equalizer backend'
  'socat: optional EasyEffects control transport for equalizer'
  'brightnessctl: optional fallback CLI for backlight control (handled natively by alis-native)'
  'libqalculate: optional symbolic math fallback for calculator (handled natively by alis-native)'
  'translate-shell: optional offline/CLI fallback for translation widget (handled natively by alis-native)'
  'libnotify: optional notify-send CLI for external scripts (internal notifications handled natively)'
  'playerctl: optional MPRIS CLI utility (handled natively via Quickshell MPRIS and D-Bus)'
  'alis-workflow-parser: native QML parser capability for Code Workflow'
  'python-evdev: input device access'
  'python-pillow: image processing in scripts'
  'darkly-bin: Material You Qt style'
  'kde-cli-tools: Dolphin Open With dialog (QT_QPA_PLATFORMTHEME=kde)'
  'ttf-material-symbols-variable-git: Material icons (critical for UI)'
  'ttf-jetbrains-mono-nerd: terminal/code font'
  'ttf-roboto-flex: default UI font'
  'ttf-twemoji: emoji font'
  'otf-space-grotesk: display font'
  'ttf-readex-pro: Arabic font support'
  'ttf-rubik-vf: alternate UI font'
  'ttf-oxanium: display font'
  'adw-gtk-theme: GTK theme for Material colors'
  'millennium-bin: Steam theming via Millennium (requires steam)'
  'capitaine-cursors: cursor theme'
  'whitesur-icon-theme: macOS-style icons'
  'qt6-avif-image-plugin: AVIF wallpaper support'
  'uv: Python package manager for color pipeline'
  'awww: wallpaper daemon'
  'tesseract-data-spa: Spanish OCR'
)

# Empty package — no files, only dependency tracking
package() {
  : # intentionally empty
}
