pkgname=alis-fonts
pkgver=1.0
pkgrel=2
pkgdesc='Alis - fonts and theming dependency bundle'
arch=(any)
license=('GPL-3.0-only')
depends=(
  fontconfig
  noto-fonts-emoji
  ttf-dejavu
  ttf-liberation
  ttf-roboto
  ttf-roboto-mono
  glib2

  # Qt theming
  kvantum
  plasma-integration
)

# Open-licensed UI & icon fonts (Material Symbols Rounded, Roboto Flex,
# Gabarito, Rubik, Readex Pro, Oxanium, Twemoji) are bundled directly inside
# Alis's assets/fonts/ directory so fragile AUR -git font packages are no
# longer required.
