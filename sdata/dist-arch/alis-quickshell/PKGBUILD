# Quickshell and Qt6 dependencies for Alis
# Pure Qt6/Quickshell runtime — no KDE Frameworks QML (kirigami / syntax-highlighting) required.

pkgname=alis-quickshell
pkgver=1.0
pkgrel=2
pkgdesc='Alis - Quickshell and Qt6 dependency bundle'
arch=(any)
license=('GPL-3.0-only')
depends=(
  # Quickshell (official extra repo)
  quickshell

  # Core Qt6
  qt6-declarative
  qt6-base
  qt6-svg
  qt6-wayland

  # Qt6 extras
  qt6-5compat
  qt6-imageformats
  qt6-multimedia
  qt6-positioning
  qt6-quicktimeline
  qt6-sensors
  qt6-tools
  qt6-translations
  qt6-virtualkeyboard

  # System libs for Quickshell
  jemalloc
  libpipewire
  libxcb
  wayland
  libdrm
  mesa

  # Qt theming
  qt6ct
  breeze-icons
)
