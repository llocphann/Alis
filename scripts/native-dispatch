#!/usr/bin/env bash
set -uo pipefail

if [[ "${BASH_SOURCE[0]}" == /*/scripts/native-dispatch ]]; then
    ROOT_DIR="${BASH_SOURCE[0]%/scripts/native-dispatch}"
else
    ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
fi
source "$ROOT_DIR/scripts/lib/brand-env-compat.sh"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/alis"
MODE_FILE="$STATE_DIR/native-backend"
MODE="${ALIS_NATIVE_BACKEND:-}"
if [[ -z "$MODE" && -r "$MODE_FILE" ]]; then
    IFS= read -r MODE < "$MODE_FILE" || true
fi
# Rust is the production default; persisted state or an explicit environment override can force Python.
MODE="${MODE:-rust}"
case "$MODE" in
    python|rust|auto) ;;
    *) echo "[native-dispatch] invalid ALIS_NATIVE_BACKEND=$MODE" >&2; exit 64 ;;
esac
BIN_DIR_FILE="$STATE_DIR/native-bin-dir"
BIN_DIR="${ALIS_NATIVE_BIN_DIR:-}"
if [[ -z "$BIN_DIR" && -r "$BIN_DIR_FILE" ]]; then
    IFS= read -r BIN_DIR < "$BIN_DIR_FILE" || true
fi
DEFAULT_BIN_DIR="$ROOT_DIR/native/bin"
if [[ ! -x "$DEFAULT_BIN_DIR/alis-native" && -x "$ROOT_DIR/native/target/release/alis-native" ]]; then
    DEFAULT_BIN_DIR="$ROOT_DIR/native/target/release"
fi
if [[ ! -x "$DEFAULT_BIN_DIR/alis-native" ]]; then
    REAL_ROOT_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd -P || true)"
    if [[ -n "$REAL_ROOT_DIR" && -x "$REAL_ROOT_DIR/native/bin/alis-native" ]]; then
        DEFAULT_BIN_DIR="$REAL_ROOT_DIR/native/bin"
    elif [[ -n "$REAL_ROOT_DIR" && -x "$REAL_ROOT_DIR/native/target/release/alis-native" ]]; then
        DEFAULT_BIN_DIR="$REAL_ROOT_DIR/native/target/release"
    fi
fi
BIN_DIR="${BIN_DIR:-$DEFAULT_BIN_DIR}"
STRICT="${ALIS_NATIVE_STRICT:-0}"
MPD_SOCKET="${ALIS_MPD_SOCKET:-${XDG_RUNTIME_DIR:-/tmp}/alis/mpd.sock}"

python_bin() {
    local candidate=""
    if [[ -n "${ALIS_VENV:-}" ]]; then
        candidate="${ALIS_VENV/#\~/$HOME}/bin/python3"
    elif [[ -n "${ILLOGICAL_IMPULSE_VIRTUAL_ENV:-}" ]]; then
        candidate="${ILLOGICAL_IMPULSE_VIRTUAL_ENV/#\~/$HOME}/bin/python3"
    else
        candidate="$HOME/.local/state/quickshell/.venv/bin/python3"
    fi
    if [[ -x "$candidate" ]]; then
        printf '%s\n' "$candidate"
    elif command -v python3 >/dev/null 2>&1; then
        # Nix wrappers provide the packaged Python environment through PATH.
        # Prefer it over a host /usr/bin/python3 so Python fallback keeps its
        # declared dependencies without switchwall activating a venv first.
        command -v python3
    elif [[ -x /usr/bin/python3 ]]; then
        printf '%s\n' /usr/bin/python3
    else
        return 127
    fi
}

want_rust() {
    case "$MODE" in
        rust|auto) return 0 ;;
        *) return 1 ;;
    esac
}

rust_ready() {
    local binary="$1"
    [[ -x "$BIN_DIR/$binary" ]]
}

cmd="${1:-}"
[[ -n "$cmd" ]] || {
    echo "usage: native-dispatch <input-lock|input-keys|niri|clipboard-store|mpd|mpd-daemon|mpd-subscribe|lyrics|theme|theme-preview|least-busy-region|scan-plugins|telemetry|desktop-icons|companion|backend-info> [args...]" >&2
    exit 64
}
shift

if [[ "$MODE" == rust && "$STRICT" == 1 ]]; then
    required_binary=""
    case "$cmd" in
        input-lock|input-keys) required_binary=alis-inputd ;;
        niri|clipboard-store|desktop-icons|scan-plugins|telemetry) required_binary=alis-native ;;
        mpd|mpd-daemon|mpd-subscribe|lyrics) required_binary=alis-mpdd ;;
        theme|theme-preview|least-busy-region) required_binary=alis-theme ;;
    esac
    if [[ -n "$required_binary" ]] && ! rust_ready "$required_binary"; then
        echo "[native-dispatch] missing Rust binary: $BIN_DIR/$required_binary" >&2
        exit 127
    fi
fi

case "$cmd" in
    backend-info)
        printf 'mode=%s\n' "$MODE"
        printf 'bin_dir=%s\n' "$BIN_DIR"
        for binary in alis-inputd alis-native alis-mpdd alis-theme; do
            if rust_ready "$binary"; then
                printf '%s=ready\n' "$binary"
            else
                printf '%s=missing\n' "$binary"
            fi
        done
        ;;

    input-lock)
        if want_rust && rust_ready alis-inputd; then
            if (( $# == 0 )); then
                exec "$BIN_DIR/alis-inputd" --mode locks
            fi
            "$BIN_DIR/alis-inputd" --mode locks "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust input-lock failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 -u "$ROOT_DIR/scripts/daemon/keyboard_lock_state_daemon.py" "$@"
        ;;

    input-keys)
        if want_rust && rust_ready alis-inputd; then
            if (( $# == 0 )); then
                exec "$BIN_DIR/alis-inputd" --mode keys
            fi
            "$BIN_DIR/alis-inputd" --mode keys "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust input-keys failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 -u "$ROOT_DIR/scripts/daemon/osk_physical_key_daemon.py" "$@"
        ;;

    niri)
        if want_rust && rust_ready alis-native; then
            # Niri helpers return machine-readable JSON on stdout. Capture it
            # until the Rust attempt has succeeded so a failed Rust response
            # cannot be concatenated with the Python fallback response.
            rust_stdout="$(
                ALIS_SHELL_ROOT="${ALIS_SHELL_ROOT:-$ROOT_DIR}" \
                    "$BIN_DIR/alis-native" niri "$@"
            )"
            rc=$?
            if (( rc == 0 )); then
                [[ -z "$rust_stdout" ]] || printf '%s\n' "$rust_stdout"
                exit 0
            fi
            if (( STRICT == 1 )); then
                [[ -z "$rust_stdout" ]] || printf '%s\n' "$rust_stdout"
                exit "$rc"
            fi
            if [[ -n "$rust_stdout" ]]; then
                printf '%s\n' "$rust_stdout" >&2
            fi
            echo "[native-dispatch] Rust niri helper failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/niri-config.py" "$@"
        ;;

    clipboard-store)
        if want_rust && rust_ready alis-native; then
            "$BIN_DIR/alis-native" clipboard-filter "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust clipboard filter failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/clipboard-store.py" "$@"
        ;;

    mpd)
        if want_rust && rust_ready alis-mpdd; then
            if [[ -S "$MPD_SOCKET" ]]; then
                "$BIN_DIR/alis-mpdd" --client-compat --socket "$MPD_SOCKET" "$@"
                rc=$?
                if (( rc != 75 || STRICT == 1 )); then
                    exit "$rc"
                fi
                echo "[native-dispatch] Rust MPD daemon transport unavailable, using direct compatibility mode" >&2
            fi

            "$BIN_DIR/alis-mpdd" --compat "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust MPD compatibility mode failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/local_music_mpd.py" "$@"
        ;;

    mpd-daemon)
        if want_rust && rust_ready alis-mpdd; then
            exec "$BIN_DIR/alis-mpdd" --socket "$MPD_SOCKET" "$@"
        fi
        echo "[native-dispatch] persistent MPD daemon requires the Rust backend" >&2
        exit 69
        ;;

    mpd-subscribe)
        if want_rust && rust_ready alis-mpdd; then
            exec "$BIN_DIR/alis-mpdd" --subscribe --socket "$MPD_SOCKET"
        fi
        echo "[native-dispatch] MPD event subscription requires the Rust backend" >&2
        exit 69
        ;;

    lyrics)
        track="${1:-}"
        [[ -n "$track" ]] || { echo "lyrics requires a track path" >&2; exit 64; }
        if want_rust && rust_ready alis-mpdd; then
            "$BIN_DIR/alis-mpdd" --lyrics "$track"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust lyrics parser failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/local_music_lyrics.py" "$track"
        ;;

    theme)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust theme generator failed ($rc), falling back to Python" >&2
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/colors/generate_colors_material.py" "$@"
        ;;

    theme-preview)
        preview_path="${1:-}"
        preview_opts="${2:-"{}"}"
        [[ -n "$preview_path" ]] || { echo "theme-preview requires a wallpaper path" >&2; exit 64; }
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --path "$preview_path" --preview-options "$preview_opts"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust theme-preview failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/colors/preview-palette.py" "$preview_path" "$preview_opts"
        ;;

    least-busy-region)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --least-busy-region "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust least-busy-region failed ($rc), falling back to Python" >&2
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/images/least_busy_region.py" "$@"
        ;;

    color-tags)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --color-tags "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust color-tags failed ($rc), falling back to Python" >&2
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/colors/wallpaper-color-tags.py" "$@"
        ;;

    vscode-theme)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --vscode-theme "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust vscode-theme failed ($rc), falling back to Python/Go" >&2
        fi
        exit 69
        ;;

    opencode-theme)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --opencode-theme "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust opencode-theme failed ($rc), falling back to Python/Go" >&2
        fi
        exit 69
        ;;

    zed-theme)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --zed-theme "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust zed-theme failed ($rc), falling back to Python/Go" >&2
        fi
        exit 69
        ;;

    scan-plugins)
        if want_rust && rust_ready alis-native; then
            "$BIN_DIR/alis-native" plugins scan --shell-root "$ROOT_DIR" "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust scan-plugins failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/scan-plugins.py" "$@"
        ;;

    telemetry)
        if want_rust && rust_ready alis-native; then
            exec "$BIN_DIR/alis-native" telemetry "$@"
        fi
        echo "[native-dispatch] telemetry requires the Rust backend" >&2
        exit 69
        ;;

    desktop-icons)
        theme="${1:-}"
        [[ -n "$theme" ]] || { echo "desktop-icons requires a theme" >&2; exit 64; }
        if want_rust && rust_ready alis-native; then
            exec "$BIN_DIR/alis-native" desktop sync-icon-theme "$theme"
        fi
        echo "[native-dispatch] desktop-icons native path requested while backend is not Rust" >&2
        exit 64
        ;;

    *)
        echo "[native-dispatch] unknown command: $cmd" >&2
        exit 64
        ;;
esac
