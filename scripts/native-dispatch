#!/usr/bin/env bash
set -uo pipefail

if [[ "${BASH_SOURCE[0]}" == /*/scripts/native-dispatch ]]; then
    ROOT_DIR="${BASH_SOURCE[0]%/scripts/native-dispatch}"
else
    ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
fi
source "$ROOT_DIR/scripts/lib/brand-env-compat.sh"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/alis"
MODE_FILE="$STATE_DIR/native-backend"
MODE="${ALIS_NATIVE_BACKEND:-}"
if [[ -z "$MODE" && -r "$MODE_FILE" ]]; then
    IFS= read -r MODE < "$MODE_FILE" || true
fi
# Rust is the production default; persisted state or an explicit environment override can force Python.
MODE="${MODE:-rust}"
case "$MODE" in
    python|rust|auto) ;;
    *) echo "[native-dispatch] invalid ALIS_NATIVE_BACKEND=$MODE" >&2; exit 64 ;;
esac
DEFAULT_BIN_DIR="$ROOT_DIR/native/bin"
if [[ ! -x "$DEFAULT_BIN_DIR/alis-native" && -x "$ROOT_DIR/native/target/release/alis-native" ]]; then
    DEFAULT_BIN_DIR="$ROOT_DIR/native/target/release"
fi
if [[ ! -x "$DEFAULT_BIN_DIR/alis-native" ]]; then
    REAL_ROOT_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd -P || true)"
    if [[ -n "$REAL_ROOT_DIR" && -x "$REAL_ROOT_DIR/native/bin/alis-native" ]]; then
        DEFAULT_BIN_DIR="$REAL_ROOT_DIR/native/bin"
    elif [[ -n "$REAL_ROOT_DIR" && -x "$REAL_ROOT_DIR/native/target/release/alis-native" ]]; then
        DEFAULT_BIN_DIR="$REAL_ROOT_DIR/native/target/release"
    fi
fi
BIN_DIR_FILE="$STATE_DIR/native-bin-dir"
BIN_DIR="${ALIS_NATIVE_BIN_DIR:-}"
if [[ -z "$BIN_DIR" && -r "$BIN_DIR_FILE" ]]; then
    IFS= read -r BIN_DIR < "$BIN_DIR_FILE" || true
    if [[ "$BIN_DIR" == */.debris/* || ! -x "$BIN_DIR/alis-native" ]]; then
        BIN_DIR=""
    elif [[ "$BIN_DIR" != "$DEFAULT_BIN_DIR" && -x "$DEFAULT_BIN_DIR/alis-native" ]]; then
        for _check_bin in alis-native alis-theme alis-inputd alis-mpdd; do
            if [[ -x "$DEFAULT_BIN_DIR/$_check_bin" ]] && {
                [[ ! -x "$BIN_DIR/$_check_bin" ]] || [[ "$DEFAULT_BIN_DIR/$_check_bin" -nt "$BIN_DIR/$_check_bin" ]]
            }; then
                BIN_DIR="$DEFAULT_BIN_DIR"
                break
            fi
        done
    fi
fi
BIN_DIR="${BIN_DIR:-$DEFAULT_BIN_DIR}"
STRICT="${ALIS_NATIVE_STRICT:-0}"
MPD_SOCKET="${ALIS_MPD_SOCKET:-${XDG_RUNTIME_DIR:-/tmp}/alis/mpd.sock}"

python_bin() {
    local candidate=""
    if [[ -n "${ALIS_VENV:-}" ]]; then
        candidate="${ALIS_VENV/#\~/$HOME}/bin/python3"
    elif [[ -n "${ILLOGICAL_IMPULSE_VIRTUAL_ENV:-}" ]]; then
        candidate="${ILLOGICAL_IMPULSE_VIRTUAL_ENV/#\~/$HOME}/bin/python3"
    else
        candidate="$HOME/.local/state/quickshell/.venv/bin/python3"
    fi
    if [[ -x "$candidate" ]]; then
        printf '%s\n' "$candidate"
    elif command -v python3 >/dev/null 2>&1; then
        # Nix wrappers provide the packaged Python environment through PATH.
        # Prefer it over a host /usr/bin/python3 so Python fallback keeps its
        # declared dependencies without switchwall activating a venv first.
        command -v python3
    elif [[ -x /usr/bin/python3 ]]; then
        printf '%s\n' /usr/bin/python3
    else
        return 127
    fi
}

want_rust() {
    case "$MODE" in
        rust|auto) return 0 ;;
        *) return 1 ;;
    esac
}

rust_ready() {
    local binary="$1"
    [[ -x "$BIN_DIR/$binary" ]]
}

exec_rust_or_fallback() {
    local binary="$1"
    shift
    if rust_ready "$binary"; then
        if [[ "$BIN_DIR" == "$DEFAULT_BIN_DIR" || ! -x "$DEFAULT_BIN_DIR/$binary" || -n "${ALIS_NATIVE_BIN_DIR:-}" ]]; then
            exec "$BIN_DIR/$binary" "$@"
        fi
        local err_tmp="" rc=0
        err_tmp="$(mktemp "${TMPDIR:-/tmp}/alis-nd-err.XXXXXX" 2>/dev/null || true)"
        if [[ -n "$err_tmp" ]]; then
            "$BIN_DIR/$binary" "$@" 2>"$err_tmp"
            rc=$?
            if (( rc == 2 )) || {
                (( rc == 1 )) && grep -qE 'unknown (--[a-z0-9-]+ )?subcommand|unrecognized subcommand|unexpected argument' "$err_tmp" 2>/dev/null
            }; then
                rm -f -- "$err_tmp"
                exec "$DEFAULT_BIN_DIR/$binary" "$@"
            fi
            if [[ -s "$err_tmp" ]]; then
                cat -- "$err_tmp" >&2
            fi
            rm -f -- "$err_tmp"
            exit "$rc"
        fi
        "$BIN_DIR/$binary" "$@"
        rc=$?
        if (( rc != 2 )); then
            exit "$rc"
        fi
    fi
    if [[ "$BIN_DIR" != "$DEFAULT_BIN_DIR" && -x "$DEFAULT_BIN_DIR/$binary" && -z "${ALIS_NATIVE_BIN_DIR:-}" ]]; then
        exec "$DEFAULT_BIN_DIR/$binary" "$@"
    fi
    return 127
}

# Long-lived daemons should `exec` directly so SIGTERM/SIGINT from Quickshell
# reaches the Rust process instead of orphaning it behind a bash wrapper.
exec_rust_daemon_or_fallback() {
    local binary="$1"
    local required_flag="$2"
    shift 2
    local -a probe_args=()
    while (( $# > 0 )); do
        if [[ "$1" == "--" ]]; then
            shift
            break
        fi
        probe_args+=("$1")
        shift
    done
    if rust_ready "$binary"; then
        if [[ "$BIN_DIR" == "$DEFAULT_BIN_DIR" || ! -x "$DEFAULT_BIN_DIR/$binary" || -n "${ALIS_NATIVE_BIN_DIR:-}" ]]; then
            exec "$BIN_DIR/$binary" "$@"
        fi
        local probe_out="" probe_rc=0
        if command -v timeout >/dev/null 2>&1; then
            probe_out="$(timeout 0.5s "$BIN_DIR/$binary" "${probe_args[@]}" --help 2>/dev/null)" || probe_rc=$?
        else
            probe_out="$("$BIN_DIR/$binary" "${probe_args[@]}" --help 2>/dev/null)" || probe_rc=$?
        fi
        if (( probe_rc == 0 )); then
            if [[ -z "$required_flag" ]] || grep -Fq -- "$required_flag" <<<"$probe_out"; then
                exec "$BIN_DIR/$binary" "$@"
            fi
            exec "$DEFAULT_BIN_DIR/$binary" "$@"
        elif (( probe_rc == 2 )); then
            exec "$DEFAULT_BIN_DIR/$binary" "$@"
        elif (( probe_rc == 124 )); then
            "$BIN_DIR/$binary" "$@" &
            local child_pid=$!
            trap 'kill -TERM "$child_pid" 2>/dev/null || true' TERM
            trap 'kill -INT "$child_pid" 2>/dev/null || true' INT
            trap 'kill -HUP "$child_pid" 2>/dev/null || true' HUP
            local rc=0
            wait "$child_pid" || rc=$?
            trap - TERM INT HUP
            exit "$rc"
        fi
        exec "$DEFAULT_BIN_DIR/$binary" "$@"
    fi
    if [[ "$BIN_DIR" != "$DEFAULT_BIN_DIR" && -x "$DEFAULT_BIN_DIR/$binary" && -z "${ALIS_NATIVE_BIN_DIR:-}" ]]; then
        exec "$DEFAULT_BIN_DIR/$binary" "$@"
    fi
    return 127
}

cmd="${1:-}"
[[ -n "$cmd" ]] || {
    echo "usage: native-dispatch <backend-info|input-lock|input-keys|input-type|input-key|input-paste|input-session|input-pointer|niri|clipboard|clipboard-store|mpd|mpd-daemon|mpd-subscribe|mpd-mpris|lyrics|theme|theme-preview|least-busy-region|color-tags|find-regions|thumbgen|cover-colors|gowall|image|vscode-theme|opencode-theme|zed-theme|codex-theme|claude-theme|scan-plugins|telemetry|desktop-icons|desktop-fonts|desktop-kdeconfig|file-dialog|check-updates|audio-spectrum|mic-meter|gamma|idle|screencopy|backlight|calc|translate> [args...]" >&2
    exit 64
}
shift

if [[ "$MODE" == rust && "$STRICT" == 1 ]]; then
    required_binary=""
    case "$cmd" in
        input-lock|input-keys|input-type|input-key|input-paste|input-session|input-pointer) required_binary=alis-inputd ;;
        niri|clipboard|clipboard-store|audio-spectrum|mic-meter|gamma|idle|screencopy|desktop-icons|desktop-fonts|desktop-kdeconfig|file-dialog|check-updates|scan-plugins|telemetry|backlight|calc|translate) required_binary=alis-native ;;
        mpd|mpd-daemon|mpd-subscribe|mpd-mpris|lyrics) required_binary=alis-mpdd ;;
        theme|theme-preview|least-busy-region|color-tags|find-regions|thumbgen|cover-colors|gowall|image|vscode-theme|opencode-theme|zed-theme|codex-theme|claude-theme) required_binary=alis-theme ;;
    esac
    if [[ -n "$required_binary" ]] && ! rust_ready "$required_binary"; then
        echo "[native-dispatch] missing Rust binary: $BIN_DIR/$required_binary" >&2
        exit 127
    fi
fi

case "$cmd" in
    backend-info)
        printf 'mode=%s\n' "$MODE"
        printf 'bin_dir=%s\n' "$BIN_DIR"
        for binary in alis-inputd alis-native alis-mpdd alis-theme; do
            if rust_ready "$binary"; then
                printf '%s=ready\n' "$binary"
            else
                printf '%s=missing\n' "$binary"
            fi
        done
        ;;

    input-lock)
        if want_rust && rust_ready alis-inputd; then
            if (( $# == 0 )); then
                exec "$BIN_DIR/alis-inputd" --mode locks
            fi
            "$BIN_DIR/alis-inputd" --mode locks "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust input-lock failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 -u "$ROOT_DIR/scripts/daemon/keyboard_lock_state_daemon.py" "$@"
        ;;

    input-keys)
        if want_rust && rust_ready alis-inputd; then
            if (( $# == 0 )); then
                exec "$BIN_DIR/alis-inputd" --mode keys
            fi
            "$BIN_DIR/alis-inputd" --mode keys "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust input-keys failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 -u "$ROOT_DIR/scripts/daemon/osk_physical_key_daemon.py" "$@"
        ;;

    niri)
        if want_rust && rust_ready alis-native; then
            # Niri helpers return machine-readable JSON on stdout. Capture it
            # until the Rust attempt has succeeded so a failed Rust response
            # cannot be concatenated with the Python fallback response.
            rust_stdout="$(
                ALIS_SHELL_ROOT="${ALIS_SHELL_ROOT:-$ROOT_DIR}" \
                    "$BIN_DIR/alis-native" niri "$@"
            )"
            rc=$?
            if (( rc == 0 )); then
                [[ -z "$rust_stdout" ]] || printf '%s\n' "$rust_stdout"
                exit 0
            fi
            if (( STRICT == 1 )); then
                [[ -z "$rust_stdout" ]] || printf '%s\n' "$rust_stdout"
                exit "$rc"
            fi
            if [[ -n "$rust_stdout" ]]; then
                printf '%s\n' "$rust_stdout" >&2
            fi
            echo "[native-dispatch] Rust niri helper failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/niri-config.py" "$@"
        ;;

    clipboard-store)
        if want_rust && rust_ready alis-native; then
            "$BIN_DIR/alis-native" clipboard-filter "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust clipboard filter failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/clipboard-store.py" "$@"
        ;;

    mpd)
        if want_rust && rust_ready alis-mpdd; then
            if [[ -S "$MPD_SOCKET" ]]; then
                "$BIN_DIR/alis-mpdd" --client-compat --socket "$MPD_SOCKET" "$@"
                rc=$?
                if (( rc != 75 || STRICT == 1 )); then
                    exit "$rc"
                fi
                echo "[native-dispatch] Rust MPD daemon transport unavailable, using direct compatibility mode" >&2
            fi

            "$BIN_DIR/alis-mpdd" --compat "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust MPD compatibility mode failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/local_music_mpd.py" "$@"
        ;;

    mpd-daemon)
        if want_rust && rust_ready alis-mpdd; then
            exec "$BIN_DIR/alis-mpdd" --socket "$MPD_SOCKET" "$@"
        fi
        echo "[native-dispatch] persistent MPD daemon requires the Rust backend" >&2
        exit 69
        ;;

    mpd-subscribe)
        if want_rust && rust_ready alis-mpdd; then
            exec "$BIN_DIR/alis-mpdd" --subscribe --socket "$MPD_SOCKET"
        fi
        echo "[native-dispatch] MPD event subscription requires the Rust backend" >&2
        exit 69
        ;;

    lyrics)
        track="${1:-}"
        [[ -n "$track" ]] || { echo "lyrics requires a track path" >&2; exit 64; }
        if want_rust && rust_ready alis-mpdd; then
            "$BIN_DIR/alis-mpdd" --lyrics "$track"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust lyrics parser failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/local_music_lyrics.py" "$track"
        ;;

    theme)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust theme generator failed ($rc), falling back to Python" >&2
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/colors/generate_colors_material.py" "$@"
        ;;

    theme-preview)
        preview_path="${1:-}"
        preview_opts="${2:-"{}"}"
        [[ -n "$preview_path" ]] || { echo "theme-preview requires a wallpaper path" >&2; exit 64; }
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --path "$preview_path" --preview-options "$preview_opts"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust theme-preview failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/colors/preview-palette.py" "$preview_path" "$preview_opts"
        ;;

    least-busy-region)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --least-busy-region "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust least-busy-region failed ($rc), falling back to Python" >&2
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/images/least_busy_region.py" "$@"
        ;;

    color-tags)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --color-tags "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust color-tags failed ($rc), falling back to Python" >&2
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/colors/wallpaper-color-tags.py" "$@"
        ;;

    vscode-theme)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --vscode-theme "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust vscode-theme failed ($rc), falling back to Python/Go" >&2
        fi
        exit 69
        ;;

    opencode-theme)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --opencode-theme "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust opencode-theme failed ($rc), falling back to Python/Go" >&2
        fi
        exit 69
        ;;

    zed-theme)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --zed-theme "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust zed-theme failed ($rc), falling back to Python/Go" >&2
        fi
        exit 69
        ;;

    codex-theme)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --codex-theme "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust codex-theme failed ($rc), falling back to Python" >&2
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/colors/codex/theme_generator.py" "$@"
        ;;

    claude-theme)
        if want_rust && rust_ready alis-theme; then
            "$BIN_DIR/alis-theme" --claude-theme "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust claude-theme failed ($rc), falling back to Python" >&2
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/colors/claude/theme_generator.py" "$@"
        ;;

    scan-plugins)
        if want_rust && rust_ready alis-native; then
            "$BIN_DIR/alis-native" plugins scan --shell-root "$ROOT_DIR" "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust scan-plugins failed ($rc), falling back to Python" >&2
        fi
        exec /usr/bin/python3 "$ROOT_DIR/scripts/scan-plugins.py" "$@"
        ;;

    telemetry)
        if want_rust && rust_ready alis-native; then
            exec "$BIN_DIR/alis-native" telemetry "$@"
        fi
        echo "[native-dispatch] telemetry requires the Rust backend" >&2
        exit 69
        ;;

    desktop-icons)
        theme="${1:-}"
        [[ -n "$theme" ]] || { echo "desktop-icons requires a theme" >&2; exit 64; }
        if want_rust && rust_ready alis-native; then
            exec "$BIN_DIR/alis-native" desktop sync-icon-theme "$theme"
        fi
        echo "[native-dispatch] desktop-icons native path requested while backend is not Rust" >&2
        exit 64
        ;;

    backlight)
        if want_rust; then
            exec_rust_or_fallback alis-native backlight "$@" || true
        fi
        sub="${1:-list}"
        shift || true
        case "$sub" in
            list) command -v brightnessctl >/dev/null 2>&1 && exec brightnessctl -l -m -c backlight ;;
            get)
                dev="${1:-}"
                if command -v brightnessctl >/dev/null 2>&1; then
                    if [[ -n "$dev" ]]; then
                        printf '%s %s\n' "$(brightnessctl -d "$dev" g)" "$(brightnessctl -d "$dev" m)"
                    else
                        printf '%s %s\n' "$(brightnessctl -c backlight g)" "$(brightnessctl -c backlight m)"
                    fi
                    exit 0
                fi
                ;;
            set)
                target="${1:-}"
                shift || true
                dev=""
                min_v="1"
                while (($#)); do
                    case "$1" in
                        -d|--device) dev="${2:-}"; shift 2 ;;
                        --min-value) min_v="${2:-1}"; shift 2 ;;
                        *) shift ;;
                    esac
                done
                if command -v brightnessctl >/dev/null 2>&1; then
                    if [[ -n "$dev" ]]; then
                        exec brightnessctl -d "$dev" --min-value="$min_v" s "$target" --quiet
                    else
                        exec brightnessctl -c backlight --min-value="$min_v" s "$target" --quiet
                    fi
                fi
                ;;
        esac
        exit 127
        ;;

    calc)
        if want_rust; then
            exec_rust_or_fallback alis-native calc "$@" || true
        fi
        command -v qalc >/dev/null 2>&1 && exec qalc -t "$*"
        exit 127
        ;;

    translate)
        if want_rust; then
            exec_rust_or_fallback alis-native translate "$@" || true
        fi
        if [[ "${1:-}" == "--list-languages" ]]; then
            printf 'auto\nen\nvi\nja\nko\nzh-CN\nzh-TW\nfr\nde\nes\nru\n'
            exit 0
        fi
        command -v trans >/dev/null 2>&1 && exec trans -b -no-theme -no-bidi -no-ansi "$@"
        exit 127
        ;;

    clipboard)
        if want_rust; then
            if [[ "${1:-}" == "watch" ]]; then
                exec_rust_daemon_or_fallback alis-native "" clipboard watch -- clipboard "$@" || true
            else
                exec_rust_or_fallback alis-native clipboard "$@" || true
            fi
        fi
        sub="${1:-}"
        shift || true
        case "$sub" in
            copy) command -v wl-copy >/dev/null 2>&1 && exec wl-copy "$@" ;;
            paste) command -v wl-paste >/dev/null 2>&1 && exec wl-paste "$@" ;;
            list) command -v cliphist >/dev/null 2>&1 && exec cliphist list ;;
            decode) command -v cliphist >/dev/null 2>&1 && exec cliphist decode "$@" ;;
            delete) command -v cliphist >/dev/null 2>&1 && exec cliphist delete "$@" ;;
            wipe) command -v cliphist >/dev/null 2>&1 && exec cliphist wipe ;;
            store) command -v cliphist >/dev/null 2>&1 && exec cliphist store ;;
        esac
        exit 127
        ;;

    audio-spectrum)
        if [[ ! -v PIPEWIRE_PROPS && ! -v PIPEWIRE_LATENCY ]]; then
            export PIPEWIRE_PROPS='{ node.latency = null }'
        fi
        if want_rust; then
            exec_rust_daemon_or_fallback alis-native "" audio spectrum -- audio spectrum "$@" || true
        fi
        exec /usr/bin/bash "$ROOT_DIR/scripts/cava/run.sh" "$@"
        ;;

    mic-meter)
        if want_rust; then
            exec_rust_daemon_or_fallback alis-native "" audio mic-meter -- audio mic-meter "$@" || true
        fi
        exec /usr/bin/python3 -u "$ROOT_DIR/scripts/audio/mic-level-meter.py" "$@"
        ;;

    gamma)
        if want_rust; then
            exec_rust_daemon_or_fallback alis-native "" gamma -- gamma "$@" || true
        fi
        command -v wlsunset >/dev/null 2>&1 && exec wlsunset "$@"
        exit 127
        ;;

    idle)
        if want_rust; then
            exec_rust_daemon_or_fallback alis-native "" idle -- idle "$@" || true
        fi
        command -v swayidle >/dev/null 2>&1 && exec swayidle "$@"
        exit 127
        ;;

    screencopy)
        if want_rust; then
            exec_rust_or_fallback alis-native screencopy "$@" || true
        fi
        command -v grim >/dev/null 2>&1 && exec grim "$@"
        exit 127
        ;;

    input-type)
        if want_rust; then
            exec_rust_or_fallback alis-inputd --type "$@" || true
        fi
        command -v wtype >/dev/null 2>&1 && exec wtype "$@"
        exit 127
        ;;

    input-key)
        if want_rust; then
            exec_rust_or_fallback alis-inputd --key "$@" || true
        fi
        command -v ydotool >/dev/null 2>&1 && exec ydotool key "$@"
        exit 127
        ;;

    input-pointer)
        if want_rust; then
            exec_rust_or_fallback alis-inputd --pointer "$@" || true
        fi
        exit 127
        ;;

    input-paste)
        if want_rust; then
            exec_rust_or_fallback alis-inputd --paste || true
        fi
        command -v ydotool >/dev/null 2>&1 && exec ydotool key -d 1 29:1 47:1 47:0 29:0
        exit 127
        ;;

    input-session)
        if want_rust; then
            exec_rust_daemon_or_fallback alis-inputd "--vkeyboard-session" -- --vkeyboard-session || true
        fi
        exit 127
        ;;

    mpd-mpris)
        if want_rust; then
            exec_rust_daemon_or_fallback alis-mpdd "--mpris" -- --mpris "$@" || true
        fi
        if command -v mpd-mpris >/dev/null 2>&1; then
            mpd_mpris_args=()
            skip_next=0
            for arg in "$@"; do
                if (( skip_next )); then
                    skip_next=0
                    continue
                fi
                case "$arg" in
                    --music-root) skip_next=1 ;;
                    --music-root=*) ;;
                    *) mpd_mpris_args+=("$arg") ;;
                esac
            done
            exec mpd-mpris "${mpd_mpris_args[@]}"
        fi
        exit 127
        ;;

    desktop-fonts)
        if want_rust; then
            exec_rust_or_fallback alis-native desktop sync-fonts "$@" || true
        fi
        exit 69
        ;;

    desktop-kdeconfig)
        if want_rust; then
            exec_rust_or_fallback alis-native desktop set-kde-config "$@" || true
        fi
        exit 69
        ;;

    file-dialog)
        if want_rust; then
            exec_rust_or_fallback alis-native desktop file-dialog "$@" || true
        fi
        exit 69
        ;;

    check-updates)
        if want_rust; then
            exec_rust_or_fallback alis-native desktop check-updates || true
        fi
        command -v checkupdates >/dev/null 2>&1 && exec checkupdates
        exit 127
        ;;

    thumbgen)
        if want_rust; then
            exec_rust_or_fallback alis-theme --thumbgen "$@" || true
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/thumbnails/thumbgen.py" "$@"
        ;;

    find-regions)
        if want_rust; then
            exec_rust_or_fallback alis-theme --find-regions "$@" || true
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/images/find_regions.py" "$@"
        ;;

    cover-colors)
        if want_rust; then
            exec_rust_or_fallback alis-theme --cover-colors "$@" || true
        fi
        py="$(python_bin)"
        exec "$py" "$ROOT_DIR/scripts/cava/extract_cover_colors.py" "$@"
        ;;

    gowall)
        if want_rust; then
            exec_rust_or_fallback alis-theme --gowall "$@" || true
        fi
        command -v gowall >/dev/null 2>&1 && exec gowall "$@"
        exit 127
        ;;

    image)
        if want_rust; then
            exec_rust_or_fallback alis-theme --image "$@" || true
        fi
        exit 69
        ;;

    *)
        echo "[native-dispatch] unknown command: $cmd" >&2
        exit 64
        ;;
esac
