pkgbase = alis-shell
	pkgdesc = Alis shell payload, launcher, and user service
	pkgver = r0.g0000000
	pkgrel = 1
	url = https://github.com/llocphann/Alis
	install = alis-shell.install
	arch = x86_64
	license = GPL-3.0-only
	makedepends = cargo
	depends = bash
	depends = curl
	depends = fontconfig
	depends = libnotify
	depends = networkmanager
	depends = niri
	depends = noto-fonts-emoji
	depends = pipewire
	depends = pipewire-alsa
	depends = pipewire-pulse
	depends = polkit
	depends = python
	depends = qt6-5compat
	depends = qt6-imageformats
	depends = qt6-multimedia
	depends = qt6-multimedia-ffmpeg
	depends = qt6-quicktimeline
	depends = quickshell
	depends = rsync
	depends = ttf-jetbrains-mono-nerd
	depends = wireplumber
	depends = xdg-desktop-portal
	depends = xdg-desktop-portal-gnome
	depends = xdg-desktop-portal-gtk
	depends = xdg-user-dirs
	depends = xdg-utils
	depends = xwayland-satellite
	optdepends = awww: optional external animated wallpaper daemon (Alis ships built-in GPU transitions)
	optdepends = blueman: Bluetooth device management
	optdepends = breeze-icons: fallback icon theme
	optdepends = ddcutil: external monitor brightness control
	optdepends = easyeffects: optional audio effects and equalizer backend
	optdepends = ffmpeg: recording and video wallpaper helpers
	optdepends = fprintd: fingerprint authentication integration
	optdepends = geoclue: GPS-backed weather location detection
	optdepends = gnome-keyring: secret storage for API keys and credentials
	optdepends = kde-cli-tools: Dolphin Open With dialog (QT_QPA_PLATFORMTHEME=kde)
	optdepends = kitty: default terminal integration
	optdepends = kvantum: Qt style engine
	optdepends = mission-center: graphical system monitor (default task manager)
	optdepends = mpv: media playback
	optdepends = mpd: local Music library and queue backend
	optdepends = mpd-mpris: optional external MPD MPRIS bridge (built-in MPRIS provided by alis-mpdd)
	optdepends = gtk4: runtime library for built-in Alis Files manager
	optdepends = nm-connection-editor: default network settings GUI
	optdepends = pavucontrol: advanced audio mixer UI
	optdepends = plasma-browser-integration: browser MPRIS sessions and artwork
	optdepends = plasma-integration: Qt platform theme integration
	optdepends = polkit-gnome: optional standalone polkit agent (Alis ships a built-in Quickshell Polkit agent)
	optdepends = qt6ct: Qt theme configuration
	optdepends = socat: optional EasyEffects control transport for equalizer
	optdepends = swappy: optional external screenshot annotation editor (Alis ships a built-in editor)
	optdepends = swaylock: optional fallback screen locker (Alis ships a built-in Quickshell lockscreen)
	optdepends = tesseract: OCR-backed screenshot tools
	optdepends = thinkfan: managed fan-control integration
	optdepends = upower: battery monitoring service
	optdepends = uv: optional Python environment manager for opt-in AI wallfx cutout
	optdepends = wf-recorder: screen recording support
	optdepends = millennium-bin: Steam theming via Millennium (requires steam)
	conflicts = alis-shell-git
	conflicts = noctalia-qs
	conflicts = noctalia-shell
	conflicts = cachyos-niri-noctalia
	source = alis-r0.g0000000-dev.tar.gz::https://github.com/llocphann/Alis/archive/dev.tar.gz
	sha256sums = SKIP

pkgname = alis-shell
