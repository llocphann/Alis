pkgname=alis-shell
pkgver=2.29.3
pkgrel=17
pkgdesc='Alis shell payload, launcher, and user service'
arch=('x86_64')
url='https://github.com/llocphann/Alis'
license=('GPL-3.0-only')
install=alis-shell.install
# Hadalis does not publish version tags/releases yet. Keep the non-VCS package
# reproducible by pinning the reviewed source snapshot; release automation can
# switch this to a tag once the project publishes one.
_source_ref="${ALIS_SOURCE_REF:-c74d8a2336a311699ced1a00898bc4b2527a3a45}"
_default_source_archive="https://github.com/llocphann/Alis/archive/${_source_ref}.tar.gz"
_source_archive="${ALIS_SOURCE_ARCHIVE:-${_default_source_archive}}"
_source_dir="${ALIS_SOURCE_DIR:-Alis-${_source_ref}}"
makedepends=(cargo)
depends=(
  bash
  brightnessctl
  cliphist
  curl
  fish
  grim
  jq
  kirigami
  libnotify
  networkmanager
  niri
  noto-fonts-emoji
  pipewire
  pipewire-alsa
  pipewire-pulse
  playerctl
  polkit-gnome
  python
  python-materialyoucolor
  python-numpy
  python-pillow
  qt6-5compat
  qt6-imageformats
  qt6-multimedia
  qt6-multimedia-ffmpeg
  qt6-quicktimeline
  quickshell
  rsync
  slurp
  swayidle
  swaylock
  wlsunset
  syntax-highlighting
  ttf-jetbrains-mono-nerd
  ttf-material-symbols-variable
  ttf-roboto-flex
  wireplumber
  wl-clipboard
  xdg-desktop-portal
  xdg-desktop-portal-gnome
  xdg-desktop-portal-gtk
  xdg-user-dirs
  xdg-utils
  xwayland-satellite
)
optdepends=(
  'awww: animated wallpaper support'
  'blueman: Bluetooth device management'
  'breeze-icons: fallback icon theme'
  'cava: audio visualizer'
  'ddcutil: external monitor brightness control'
  'easyeffects: optional audio effects and equalizer backend'
  'ffmpeg: recording and video wallpaper helpers'
  'fprintd: fingerprint authentication integration'
  'geoclue: GPS-backed weather location detection'
  'gnome-keyring: secret storage for API keys and credentials'
  'gowall-bin: wallpaper theme conversion and effects editor'
  'gum: setup TUI helpers'
  'hyprpicker: color picker support'
  'kde-cli-tools: Dolphin Open With dialog (QT_QPA_PLATFORMTHEME=kde)'
  'imagemagick: image conversion helpers'
  'kconfig: KDE configuration integration'
  'kdialog: KDE dialog integration for scripts'
  'kitty: default terminal integration'
  'kvantum: Qt style engine'
  'libqalculate: calculator widget backend'
  'mission-center: graphical system monitor (default task manager)'
  'mpv: media playback and YouTube Music support'
  'mpv-mpris: richer mpv media session integration'
  'mpd: local Music library and queue backend'
  'mpd-mpris: MPD/rmpc/Alis Music controls through MPRIS'
  'nautilus: default file manager integration'
  'nm-connection-editor: default network settings GUI'
  'pavucontrol: advanced audio mixer UI'
  'pacman-contrib: package update checking'
  'plasma-browser-integration: browser MPRIS sessions and artwork'
  'plasma-integration: Qt platform theme integration'
  'qt6ct: Qt theme configuration'
  'songrec: music recognition support'
  'socat: optional EasyEffects control transport for equalizer'
  'swappy: screenshot annotation helpers'
  'tesseract: OCR-backed screenshot tools'
  'thinkfan: managed fan-control integration'
  'translate-shell: translation helpers'
  'ttf-oxanium: angel style font'
  'upower: battery monitoring service'
  'uv: packaged Python environment management'
  'wf-recorder: screen recording support'
  'wtype: Wayland text injection helper'
  'ydotool: virtual keyboard and clipboard paste helper'
  'yt-dlp: YouTube media backend'
  'python-ytmusicapi: YouTube Music browsing (InnerTube engine)'
  'millennium-bin: Steam theming via Millennium (requires steam)'
)
conflicts=('alis-shell-git' 'noctalia-qs' 'noctalia-shell' 'cachyos-niri-noctalia')
source=(
  "alis-${pkgver}-${_source_ref}.tar.gz::${_source_archive}"
)
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/${_source_dir}"
  cargo fetch --locked --manifest-path native/Cargo.toml --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$srcdir/${_source_dir}"
  export CARGO_TARGET_DIR="$srcdir/alis-native-target"
  cargo build --frozen --release --workspace --manifest-path native/Cargo.toml
}

package() {
  local srcroot="${srcdir}/${_source_dir}"
  local shellroot="${pkgdir}/usr/share/quickshell/alis"
  local docroot="${pkgdir}/usr/share/doc/${pkgname}"
  local timestamp
  timestamp="$(date -Iseconds)"

  python3 "$srcroot/sdata/lib/runtime-payload.py" copy --root "$srcroot" --target "$shellroot" || return
  mkdir -p "$shellroot/native/bin"
  for binary in alis-inputd alis-mpdd alis-native alis-theme; do install -Dm0755 "$srcdir/alis-native-target/release/$binary" "$shellroot/native/bin/$binary"; done
  # Keep the root namespace present for older source overrides as well.
  install -Dm644 "$srcroot/qmldir" "$shellroot/qmldir"
  chmod +x "$shellroot/setup" "$shellroot/scripts/alis"
  find "$shellroot/scripts" -type f \( -name '*.sh' -o -name '*.fish' -o -name '*.py' \) -exec chmod +x {} +
  python3 -c 'from pathlib import Path; import sys; p=Path(sys.argv[1]); t=p.read_text(); m="sync_launcher_from_repo() {\n"; assert t.count(m) == 1, "expected one sync_launcher_from_repo definition"; g=m+"    if [[ \"$(get_installed_update_strategy 2>/dev/null || true)\" == \"package-manager\" ]]; then\n        return 0\n    fi\n"; p.write_text(t.replace(m, g, 1))' "$shellroot/setup"
  grep -Fq 'get_installed_update_strategy 2>/dev/null || true' "$shellroot/setup" || return

  install -Dm755 "$srcroot/scripts/alis" "$pkgdir/usr/bin/alis"
  install -Dm644 "$srcroot/assets/systemd/alis.service" "$pkgdir/usr/lib/systemd/user/alis.service"
  # Privileged gateway is shipped by the trusted Hadalis system package.
  # Optional Hadalird helper payloads are not bundled in Core.
  install -Dm755 "$srcroot/assets/helpers/alis-hadalird-system-provision" "$pkgdir/usr/libexec/alis-hadalird-system-provision"
  install -Dm644 "$srcroot/assets/polkit/org.alis.hadalird-system-provision.policy" "$pkgdir/usr/share/polkit-1/actions/org.alis.hadalird-system-provision.policy"

  for launcher in "$pkgdir/usr/bin/alis" "$shellroot/scripts/alis"; do
    python3 - "$launcher" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text()

install_marker = "install_user_service() {\n"
install_next_marker = "\ncleanup_stale_wants_links() {\n"
install_guard = """install_user_service() {
    require_command systemctl
    local package_unit="/usr/lib/systemd/user/alis.service"
    local user_unit="$systemd_user_dir/alis.service"

    if [[ ! -f "$package_unit" ]]; then
        echo "package-owned alis.service is missing; reinstall the alis-shell package" >&2
        return 1
    fi

    if [[ -e "$user_unit" || -L "$user_unit" ]]; then
        if [[ -f "$user_unit" ]] && cmp -s "$user_unit" "$package_unit"; then
            rm -f "$user_unit"
        else
            echo "custom user alis.service shadows the package unit: $user_unit" >&2
            echo "move or remove that override before using the package-managed service" >&2
            return 1
        fi
    fi

    cleanup_stale_wants_links
    local correct_target correct_link
    correct_target="$(detect_compositor_service 2>/dev/null)" || correct_target=""
    if [[ -n "$correct_target" ]]; then
        correct_link="$systemd_user_dir/${correct_target}.wants/alis.service"
        if [[ -e "$correct_link" || -L "$correct_link" ]]; then
            ln -sf "$package_unit" "$correct_link"
        fi
    fi
    systemctl --user daemon-reload
    printf '%s\\n' "$package_unit"
    return 0
}
"""
if text.count(install_marker) != 1:
    raise SystemExit("expected exactly one install_user_service definition")
install_start = text.index(install_marker)
install_end = text.find(install_next_marker, install_start)
if install_end < 0:
    raise SystemExit("cleanup_stale_wants_links must follow install_user_service")
text = text[:install_start] + install_guard + text[install_end:]

link_marker = 'ln -sf "$systemd_user_dir/alis.service" "$wants_dir/alis.service"'
link_value = 'ln -sf "/usr/lib/systemd/user/alis.service" "$wants_dir/alis.service"'
if text.count(link_marker) != 1:
    raise SystemExit("expected exactly one compositor wants link")
text = text.replace(link_marker, link_value, 1)

uninstall_marker = """        uninstall|remove)
            disable_alis_service 2>/dev/null || true
            require_command systemctl
            rm -f "$systemd_user_dir/alis.service"
            systemctl --user daemon-reload
            echo "Uninstalled alis.service"
            ;;
"""
uninstall_guard = """        uninstall|remove)
            echo "alis.service is owned by the pacman package; use 'alis service disable' to remove compositor wiring or pacman to remove the package" >&2
            return 1
            ;;
"""
if text.count(uninstall_marker) != 1:
    raise SystemExit("expected exactly one service uninstall branch")
text = text.replace(uninstall_marker, uninstall_guard, 1)

text = text.replace(
    "install     Write the user unit file from the current launcher path",
    "install     Validate the package-owned user unit and migrate an identical legacy copy",
    1,
)
text = text.replace(
    "  unit: ${systemd_user_dir}/alis.service",
    "  unit: /usr/lib/systemd/user/alis.service",
    1,
)
text = text.replace(
    "— run 'alis service install' to fix",
    "— reinstall/update the alis-shell package to fix",
    1,
)
path.write_text(text)
PY
    bash -n "$launcher" || return
    grep -Fq 'local package_unit="/usr/lib/systemd/user/alis.service"' "$launcher" || return
    grep -Fq 'cmp -s "$user_unit" "$package_unit"' "$launcher" || return
    grep -Fq 'ln -sf "$package_unit" "$correct_link"' "$launcher" || return
    grep -Fq 'ln -sf "/usr/lib/systemd/user/alis.service"' "$launcher" || return
    grep -Fq 'alis.service is owned by the pacman package' "$launcher" || return
  done

  install -Dm644 "$srcroot/assets/applications/alis.desktop" "$pkgdir/usr/share/applications/alis.desktop"
  install -Dm644 "$srcroot/assets/applications/alis-settings.desktop" "$pkgdir/usr/share/applications/alis-settings.desktop"
  install -Dm644 "$srcroot/assets/icons/desktop-symbolic.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/alis.svg"
  install -Dm644 "$srcroot/distro/arch/alis-shell/alis-quickshell-rebuild.hook" \
    "$pkgdir/usr/share/libalpm/hooks/alis-quickshell-rebuild.hook"
  install -Dm644 "$srcroot/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcroot/README.md" "$docroot/README.md"
  for doc in "$srcroot"/docs/*.md; do
    install -Dm644 "$doc" "$docroot/${doc##*/}"
  done

  cat > "$shellroot/version.json" <<EOF
{
  "version": "${pkgver}",
  "commit": "${_source_ref}",
  "installed_at": "${timestamp}",
  "installedAt": "${timestamp}",
  "source": "pacman",
  "repo_path": "",
  "repoPath": "",
  "install_mode": "package-managed",
  "installMode": "package-managed",
  "update_strategy": "package-manager",
  "updateStrategy": "package-manager",
  "package_manager": "pacman",
  "packageManager": "pacman",
  "package_name": "alis-shell",
  "packageName": "alis-shell",
  "package_update_hint": "sudo pacman -Syu alis-shell",
  "packageUpdateHint": "sudo pacman -Syu alis-shell"
}
EOF
}
