	optdepends = easyeffects: optional audio effects and equalizer backend
	optdepends = millennium-bin: Steam theming via Millennium (requires steam)
	optdepends = mpd-mpris: optional external MPD MPRIS bridge (built-in MPRIS provided by alis-mpdd)
	optdepends = polkit-gnome: optional standalone polkit agent (Alis ships a built-in Quickshell Polkit agent)
	optdepends = socat: optional EasyEffects control transport for equalizer
	optdepends = swaylock: optional fallback screen locker (Alis ships a built-in Quickshell lockscreen)

pkgname = alis-meta
